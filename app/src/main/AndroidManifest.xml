<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "Uninstall" in the app menu: lets Android show its uninstall confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- "Keyspace wallpaper": set the bundled wallpaper when the user picks it. Granted automatically. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Microphone key: speech to text. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <!-- Package visibility: see every app that has a launcher icon. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon packs (see ICON_PACK_ACTIONS in IconPack.kt). -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="ch.deletescape.lawnchair.ICONPACK" />
        </intent>
        <!-- "Find icon packs": open the Play Store search. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- Wallpaper option: find the system wallpaper picker. -->
        <intent>
            <action android:name="android.intent.action.SET_WALLPAPER" />
        </intent>
        <!-- Needed for SpeechRecognizer to find the system recognition service (Android 11+). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Keyspace">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified">
            <!-- Makes this app selectable as the device home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also listed in the app drawer so it can be opened directly during development. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Notification dots: only runs if the user grants notification access in Settings. -->
        <service
            android:name=".KeyspaceNotificationListener"
            android:exported="true"
            android:label="@string/notification_dots"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
