<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Resources only: launchers read appfilter.xml and the drawables. -->
    <application android:hasCode="false" android:label="@string/app_name">
        <!-- The intent filters are what launchers look for; the activity itself is never opened. -->
        <activity android:name="android.app.Activity" android:exported="true">
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.novalauncher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
